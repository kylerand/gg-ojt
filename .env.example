# Server Configuration
PORT=3001
NODE_ENV=development

# Client Configuration (for build)
VITE_API_URL=http://localhost:3001

# ============================================================
# Supabase Configuration — REQUIRED
# ============================================================
# 1. Create a free project at https://supabase.com
# 2. Run supabase/schema.sql in your project's SQL Editor
# 3. Copy the values below from your project's API settings
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_KEY=your-service-role-key

# Admin User Configuration (created automatically on first start)
ADMIN_ID=admin
ADMIN_PASSWORD=CHANGE-ME-use-a-strong-password
ADMIN_EMAIL=admin@yourcompany.com

# ============================================================
# Optional Settings
# ============================================================

# Client URL (for CORS — set in production)
# CLIENT_URL=https://your-app.vercel.app

# OpenAI API Key (for AI thumbnail generation)
# OPENAI_API_KEY=sk-your-openai-api-key

# Supabase Storage (for video/image uploads — uses Supabase Storage by default)
# No extra config needed; uses SUPABASE_URL and SUPABASE_SERVICE_KEY above
